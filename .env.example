# PostgreSQL connection string (use the pooled endpoint for serverless hosts like Vercel)
# Neon example: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me"

# Optional - enables live AI replies in the chat widget. Without it, the app
# falls back to built-in canned replies.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
