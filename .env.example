# ---------------------------------------------------------------------------
# Database — Supabase (Project Settings → Database → Connection string)
# Your project ref: sabbtiueycedkrupqzku
# Replace [YOUR-PASSWORD] with the database password and [REGION] with the
# region shown in the Supabase "Connect" dialog (e.g. ap-south-1).
# ---------------------------------------------------------------------------

# App runtime: Supabase "Transaction pooler" (port 6543). Works on Vercel.
# `uselibpqcompat=true&sslmode=require` = encrypted connection that accepts
# Supabase's own certificate authority.
DATABASE_URL="postgresql://postgres.sabbtiueycedkrupqzku:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"

# Prisma CLI (migrations): Supabase "Session pooler" (port 5432, IPv4).
# Don't use db.sabbtiueycedkrupqzku.supabase.co here — on the free plan
# that host is IPv6-only and Vercel cannot reach it.
DIRECT_URL="postgresql://postgres.sabbtiueycedkrupqzku:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Secret used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me"

# Only used by `npm run db:seed` to create the first admin account.
# ADMIN_NAME="Sarwar"
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="choose-a-strong-password"

# Optional - enables live AI replies in the chat widget and AI assist.
# Without it, the app falls back to built-in template replies.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
